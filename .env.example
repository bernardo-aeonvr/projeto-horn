# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase.
# Nunca versione o .env.local nem cole chaves diretamente no código.

# Project URL (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (Supabase > Project Settings > API Keys)
# Chave pública, segura para o browser. NÃO use aqui a secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (Supabase > Project Settings > API Keys > Secret keys).
# Valor no formato sb_secret_... — o equivalente novo da antiga service_role.
#
# Usada em dois pontos, ambos no servidor:
#   1. criar a conta de Auth de um usuário de loja em Lojas > (loja) > Acesso
#      da loja, e gerar o link de definição de senha;
#   2. o keep-alive do banco (/api/keep-alive), que grava o heartbeat em
#      public.system_keepalive (migration 0021) — tabela só de service_role.
# Sem ela o sistema continua funcionando, mas a criação de acessos fica
# indisponível e o keep-alive responde 503 sem tocar o banco: em produção
# (Vercel, ambiente Production) ela é obrigatória.
#
# NUNCA prefixe com NEXT_PUBLIC_: essa chave ignora RLS e só pode existir no
# servidor. Em produção, cadastre como variável de ambiente do host.
SUPABASE_SECRET_KEY=

# Opcional. URL pública da aplicação, usada para montar o link do e-mail de
# recuperação de senha. Se não for definida, a origem da requisição é usada.
# Em produção, defina como https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=

# Opcional, mas recomendado em produção. Segredo do cron de keep-alive
# (/api/keep-alive). Cadastre na Vercel (Production) um valor aleatório de 16+
# caracteres: ela envia `Authorization: Bearer <valor>` em toda chamada
# agendada, e a rota responde 401 a quem não trouxer o segredo. Sem a variável,
# a rota responde a qualquer chamada (e avisa no log de produção).
# Para testar à mão: curl -i <url>/api/keep-alive -H "Authorization: Bearer <valor>"
CRON_SECRET=
